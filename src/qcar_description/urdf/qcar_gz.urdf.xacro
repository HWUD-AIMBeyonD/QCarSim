<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- ==================== ACKERMANN STEERING (native Gazebo plugin) ==================== -->
  <!-- This replaces ros2_control for drive. Gazebo directly handles cmd_vel to wheel commands.
       The plugin subscribes to a Twist message on <topic> and commands the steering/drive joints.
       Odometry is published on <odom_topic>. -->
  <xacro:macro name="ackermann_steering" params="namespace:=''">
    <xacro:property name="ns" value="${namespace + '/' if namespace != '' else ''}" />

    <gazebo>
      <plugin filename="gz-sim-ackermann-steering-system"
              name="gz::sim::systems::AckermannSteering">
        <topic>${ns}cmd_vel</topic>
        <left_steering_joint>fl_steering_joint</left_steering_joint>
        <right_steering_joint>fr_steering_joint</right_steering_joint>
        <left_joint>rl_wheel_joint</left_joint>
        <right_joint>rr_wheel_joint</right_joint>
        <kingpin_width>0.112</kingpin_width>
        <steering_limit>0.5236</steering_limit>
        <wheel_base>0.256</wheel_base>
        <wheel_separation>0.112</wheel_separation>
        <wheel_radius>0.033</wheel_radius>
        <!-- Odom/TF disabled — OdometryPublisher plugin handles ground truth -->
        <odom_publish_frequency>0</odom_publish_frequency>
        <publish_odom>false</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
      </plugin>

      <!-- Ground truth odometry from physics engine pose (not wheel kinematics) -->
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_topic>${ns}odom</odom_topic>
        <tf_topic>${ns}tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- ==================== JOINT STATE PUBLISHER (native Gazebo plugin) ==================== -->
  <!-- Publishes joint states for all joints so the bridge can relay them to ROS /joint_states. -->
  <xacro:macro name="joint_state_publisher" params="namespace:=''">
    <xacro:property name="ns" value="${namespace + '/' if namespace != '' else ''}" />

    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>${ns}joint_states</topic>
        <joint_name>fl_steering_joint</joint_name>
        <joint_name>fr_steering_joint</joint_name>
        <joint_name>fl_wheel_joint</joint_name>
        <joint_name>fr_wheel_joint</joint_name>
        <joint_name>rl_wheel_joint</joint_name>
        <joint_name>rr_wheel_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- ==================== GAUSS NOISE HELPER ==================== -->
  <xacro:macro name="gauss_noise"
    params="mean:=0.0 stddev:=0.0 bias_mean:=0.0 bias_stddev:=0.0 precision:=0.0">
    <noise type="gaussian">
      <mean>${mean}</mean>
      <stddev>${stddev}</stddev>
      <bias_mean>${bias_mean}</bias_mean>
      <bias_stddev>${bias_stddev}</bias_stddev>
      <precision>${precision}</precision>
    </noise>
  </xacro:macro>

  <!-- ==================== IMU SENSOR ==================== -->
  <xacro:macro name="imu" params="reference_frame namespace:=''">
    <xacro:property name="ns" value="${namespace + '/' if namespace != '' else ''}" />

    <gazebo reference="${reference_frame}">
      <sensor name="${ns}imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>${ns}imu/data_raw</topic>
        <visualize>false</visualize>
        <enable_metrics>false</enable_metrics>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><xacro:gauss_noise stddev="5.24e-3" bias_mean="2.0e-3" precision="1.07e-3" /></x>
            <y><xacro:gauss_noise stddev="5.24e-3" bias_mean="2.0e-3" precision="1.07e-3" /></y>
            <z><xacro:gauss_noise stddev="5.24e-3" bias_mean="2.0e-3" precision="1.07e-3" /></z>
          </angular_velocity>
          <linear_acceleration>
            <x><xacro:gauss_noise stddev="1.86e-3" bias_mean="1.0e-3" precision="2.40e-3" /></x>
            <y><xacro:gauss_noise stddev="1.86e-3" bias_mean="1.0e-3" precision="2.40e-3" /></y>
            <z><xacro:gauss_noise stddev="1.86e-3" bias_mean="1.0e-3" precision="2.40e-3" /></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ==================== RPLIDAR A2 ==================== -->
  <xacro:macro name="rplidar" params="reference_frame namespace:=''">
    <xacro:property name="ns" value="${namespace + '/' if namespace != '' else ''}" />

    <gazebo reference="${reference_frame}">
      <sensor name="${ns}rplidar" type="gpu_lidar">
        <update_rate>10</update_rate>
        <topic>${ns}scan</topic>
        <gz_frame_id>laser</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-${pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
        <visualize>false</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ==================== REALSENSE D435 ==================== -->
  <xacro:macro name="realsense_d435" params="reference_frame namespace:=''">
    <xacro:property name="ns" value="${namespace + '/' if namespace != '' else ''}" />

    <gazebo reference="${reference_frame}">
      <!-- Color camera -->
      <sensor name="${ns}realsense_color" type="camera">
        <update_rate>30</update_rate>
        <topic>${ns}realsense/color/image_raw</topic>
        <gz_frame_id>realsense_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.211</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>

      <!-- Depth camera -->
      <sensor name="${ns}realsense_depth" type="depth_camera">
        <update_rate>30</update_rate>
        <topic>${ns}realsense/depth/image_rect_raw</topic>
        <gz_frame_id>realsense_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.489</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ==================== CSI CAMERA ==================== -->
  <xacro:macro name="csi_camera" params="name reference_frame namespace:=''">
    <xacro:property name="ns" value="${namespace + '/' if namespace != '' else ''}" />

    <gazebo reference="${reference_frame}">
      <sensor name="${ns}${name}" type="camera">
        <update_rate>30</update_rate>
        <topic>${ns}${name}/image_raw</topic>
        <gz_frame_id>${name}_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.085</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
